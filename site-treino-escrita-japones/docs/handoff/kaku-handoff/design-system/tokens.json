    "roles": {
      "related (ícone+texto, rótulo+campo)": "gap-2 (8px)",
      "itens de um grupo (chips, botões lado a lado)": "gap-2 / gap-3 (8–12px)",
      "entre componentes dentro de um card": "gap-4 (16px)",
      "padding de card": "p-6 (24px) · compacto p-4/p-5",
      "entre cards / colunas": "gap-6 (24px)",
      "entre seções da página": "gap-8 → gap-12 (32–48px)",
      "página (desktop)": "px-20 py-10 · conteúdo max-w-7xl (1280px)",
      "página (celular)": "px-5 py-4",
      "campos de formulário": "gap-4 (16px); rótulo→campo gap-2",
      "título → texto": "gap-2 (8px); texto → conteúdo gap-4/6"
    }
  },
  "radius": {
    "values": {
      "none": 0,
      "sm": 2,
      "DEFAULT": 4,
      "md": 6,
      "lg": 8,
      "xl": 12,
      "full": 9999
    },
    "roles": {
      "rounded-md (6px)": "badges, chips pequenos, tooltips, checkboxes",
      "rounded-lg (8px)": "botões, inputs, selects, tiles, menus",
      "rounded-xl (12px)": "cards, painéis, modais, containers",
      "rounded-full": "pílulas, avatares, abas segmentadas, barras de progresso"
    }
  },
  "typography": [
    {
      "role": "Display",
      "classes": "font-serif text-6xl leading-none font-bold",
      "fontSize": 60,
      "lineHeight": "1",
      "fontWeight": 700,
      "family": "serif"
    },
    {
      "role": "H1",
      "classes": "font-serif text-5xl leading-none font-bold",
      "fontSize": 48,
      "lineHeight": "1",
      "fontWeight": 700,
      "family": "serif"
    },
    {
      "role": "H2",
      "classes": "font-serif text-3xl leading-9 font-bold",
      "fontSize": 30,
      "lineHeight": "36px",
      "fontWeight": 700,
      "family": "serif"
    },
    {
      "role": "H3",
      "classes": "text-xl leading-7 font-bold",
      "fontSize": 20,
      "lineHeight": "28px",
      "fontWeight": 700,
      "family": "sans"
    },
    {
      "role": "H4",
      "classes": "text-lg leading-7 font-bold",
      "fontSize": 18,
      "lineHeight": "28px",
      "fontWeight": 700,
      "family": "sans"
    },
    {
      "role": "Body",
      "classes": "text-base leading-6",
      "fontSize": 16,
      "lineHeight": "24px",
      "fontWeight": 400,
      "family": "sans"
    },
    {
      "role": "Body Small",
      "classes": "text-sm leading-5",
      "fontSize": 14,
      "lineHeight": "20px",
      "fontWeight": 400,
      "family": "sans"
    },
    {
      "role": "Label",
      "classes": "text-sm leading-5 font-bold",
      "fontSize": 14,
      "lineHeight": "20px",
      "fontWeight": 700,
      "family": "sans"
    },
    {
      "role": "Caption",
      "classes": "text-xs leading-4",
      "fontSize": 12,
      "lineHeight": "16px",
      "fontWeight": 400,
      "family": "sans"
    },
    {
      "role": "Overline",
      "classes": "text-xs leading-4 font-bold uppercase tracking-widest",
      "fontSize": 12,
      "lineHeight": "16px",
      "fontWeight": 700,
      "family": "sans"
    }
  ],
  "shadow": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "DEFAULT": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)",
    "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)",
    "up": "0 -10px 15px -3px rgb(0 0 0 / 0.1), 0 -4px 6px -4px rgb(0 0 0 / 0.1)"
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1536
  },
  "fonts": {
    "sans": "'Zen Kaku Gothic New',ui-sans-serif,system-ui,sans-serif",
    "serif": "'Shippori Mincho',ui-serif,Georgia,serif",
    "jp": "'Klee One','Hiragino Mincho ProN','Yu Mincho',serif"
  },
  "controls": {
    "button": {
      "sm": "h-9 px-3 text-sm",
      "md": "h-11 px-4 text-sm",
      "lg": "h-12 px-6 text-base"
    },
    "input": "h-11 px-4 text-base rounded-lg"
  }
}